{
  "openapi": "3.0.0",
  "paths": {
    "/api/users/me": {
      "get": {
        "operationId": "UsersController_getMyProfile",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Current user profile"
          }
        },
        "security": [
          {
            "access-token": []
          }
        ],
        "summary": "Get authenticated user profile",
        "tags": [
          "users"
        ]
      },
      "patch": {
        "operationId": "UsersController_updateMyProfile",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateProfileDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated user profile"
          }
        },
        "security": [
          {
            "access-token": []
          }
        ],
        "summary": "Update authenticated user profile",
        "tags": [
          "users"
        ]
      }
    },
    "/api/notifications": {
      "post": {
        "operationId": "NotificationsController_create",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateNotificationDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": ""
          }
        },
        "security": [
          {
            "access-token": []
          }
        ],
        "summary": "Create a notification and broadcast to user room",
        "tags": [
          "notifications"
        ]
      }
    },
    "/api/notifications/{id}/read": {
      "patch": {
        "operationId": "NotificationsController_markAsRead",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "security": [
          {
            "access-token": []
          }
        ],
        "summary": "Mark notification as read for current user",
        "tags": [
          "notifications"
        ]
      }
    },
    "/api/notifications/push-tokens": {
      "post": {
        "operationId": "NotificationsController_registerPushToken",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterPushTokenDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": ""
          }
        },
        "security": [
          {
            "access-token": []
          }
        ],
        "summary": "Register a push token for current user",
        "tags": [
          "notifications"
        ]
      }
    },
    "/api/notifications/push-tokens/{token}/deactivate": {
      "patch": {
        "operationId": "NotificationsController_deactivatePushToken",
        "parameters": [
          {
            "name": "token",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "security": [
          {
            "access-token": []
          }
        ],
        "summary": "Deactivate a push token for current user",
        "tags": [
          "notifications"
        ]
      }
    },
    "/api/auth/session": {
      "get": {
        "operationId": "AuthController_session",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Current authenticated user context"
          }
        },
        "security": [
          {
            "access-token": []
          }
        ],
        "summary": "Get authenticated session context",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/health": {
      "get": {
        "operationId": "HealthController_health",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "ok"
                    },
                    "timestamp": {
                      "type": "string",
                      "format": "date-time"
                    }
                  }
                }
              }
            }
          }
        },
        "summary": "Liveness probe",
        "tags": [
          "health"
        ]
      }
    },
    "/api/ai/providers": {
      "get": {
        "operationId": "AiController_listProviders",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "providers": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/AiProviderInfoDto"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "summary": "List configured AI providers",
        "tags": [
          "ai-agent"
        ]
      }
    },
    "/api/ai/chat": {
      "post": {
        "operationId": "AiController_chat",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequestDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatResponseDto"
                }
              }
            }
          }
        },
        "summary": "Chat with AI agent pool (aggregated JSON response)",
        "tags": [
          "ai-agent"
        ]
      }
    },
    "/api/ai/chat/stream": {
      "post": {
        "operationId": "AiController_chatStream",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequestDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": ""
          }
        },
        "summary": "Chat with AI agent pool (SSE stream)",
        "tags": [
          "ai-agent"
        ]
      }
    }
  },
  "info": {
    "title": "Personal OS API",
    "description": "Personal OS backend endpoints, including auth, core modules, and AI.",
    "version": "1.0",
    "contact": {}
  },
  "tags": [
    {
      "name": "health",
      "description": ""
    },
    {
      "name": "auth",
      "description": ""
    },
    {
      "name": "users",
      "description": ""
    },
    {
      "name": "notifications",
      "description": ""
    },
    {
      "name": "finances",
      "description": ""
    },
    {
      "name": "ai-agent",
      "description": ""
    }
  ],
  "servers": [],
  "components": {
    "securitySchemes": {
      "access-token": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "UpdateProfileDto": {
        "type": "object",
        "properties": {
          "fullName": {
            "type": "string"
          },
          "timezone": {
            "type": "string"
          },
          "locale": {
            "type": "string"
          },
          "avatarUrl": {
            "type": "string"
          },
          "preferences": {
            "type": "object"
          }
        }
      },
      "CreateNotificationDto": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "channel": {
            "type": "string",
            "enum": [
              "IN_APP",
              "PUSH",
              "EMAIL"
            ],
            "default": "IN_APP"
          },
          "title": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "data": {
            "type": "object"
          }
        },
        "required": [
          "userId",
          "type",
          "channel",
          "title",
          "body"
        ]
      },
      "RegisterPushTokenDto": {
        "type": "object",
        "properties": {
          "platform": {
            "type": "string",
            "enum": [
              "ios",
              "android"
            ]
          },
          "token": {
            "type": "string"
          }
        },
        "required": [
          "platform",
          "token"
        ]
      },
      "ChatMessageDto": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "user",
              "assistant",
              "system"
            ]
          },
          "content": {
            "type": "string",
            "example": "Resume mis gastos del mes en una frase."
          }
        },
        "required": [
          "role",
          "content"
        ]
      },
      "ChatRequestDto": {
        "type": "object",
        "properties": {
          "sessionId": {
            "type": "string",
            "description": "Optional AI session id to attach metrics"
          },
          "messages": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ChatMessageDto"
            }
          }
        },
        "required": [
          "messages"
        ]
      },
      "ChatResponseDto": {
        "type": "object",
        "properties": {
          "provider": {
            "type": "string",
            "example": "Groq"
          },
          "model": {
            "type": "string",
            "example": "llama-3.3-70b-versatile"
          },
          "content": {
            "type": "string",
            "example": "Aquí tienes un resumen de tus gastos del mes..."
          }
        },
        "required": [
          "provider",
          "model",
          "content"
        ]
      }
    }
  }
}