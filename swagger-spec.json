    {
      "name": "auth",
      "description": ""
    },
    {
      "name": "finances",
      "description": ""
    },
    {
      "name": "ai-agent",
      "description": ""
    }
  ],
  "servers": [],
  "components": {
    "securitySchemes": {
      "access-token": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "ChatMessageDto": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "user",
              "assistant",
              "system"
            ]
          },
          "content": {
            "type": "string",
            "example": "Resume mis gastos del mes en una frase."
          }
        },
        "required": [
          "role",
          "content"
        ]
      },
      "ChatRequestDto": {
        "type": "object",
        "properties": {
          "messages": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ChatMessageDto"
            }
          }
        },
        "required": [
          "messages"
        ]
      },
      "ChatResponseDto": {
        "type": "object",
        "properties": {
          "provider": {
            "type": "string",
            "example": "Groq"
          },
          "model": {
            "type": "string",
            "example": "llama-3.3-70b-versatile"
          },
          "content": {
            "type": "string",
            "example": "Aquí tienes un resumen de tus gastos del mes..."
          }
        },
        "required": [
          "provider",
          "model",
          "content"
        ]
      },
      "CreateAuthDto": {
        "type": "object",
        "properties": {}
      },
      "UpdateAuthDto": {
        "type": "object",
        "properties": {}
      }
    }
  }
