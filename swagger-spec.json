  "components": {
    "securitySchemes": {
      "access-token": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "UpdateProfileDto": {
        "type": "object",
        "properties": {
          "fullName": {
            "type": "string"
          },
          "timezone": {
            "type": "string"
          },
          "locale": {
            "type": "string"
          },
          "avatarUrl": {
            "type": "string"
          },
          "preferences": {
            "type": "object"
          }
        }
      },
      "UpdateModuleConfigDto": {
        "type": "object",
        "properties": {
          "config": {
            "type": "object",
            "description": "Partial module config (merged with defaults)"
          },
          "isEnabled": {
            "type": "boolean",
            "description": "Enable or disable the module for this user"
          }
        }
      },
      "CreateAccountDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "CHECKING",
              "SAVINGS",
              "CREDIT_CARD",
              "CASH",
              "INVESTMENT"
            ]
          },
          "institution": {
            "type": "string"
          },
          "currency": {
            "type": "string",
            "default": "DOP"
          },
          "color": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "type"
        ]
      },
      "UpdateAccountDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "institution": {
            "type": "string"
          },
          "color": {
            "type": "string"
          },
          "isActive": {
            "type": "boolean"
          }
        }
      },
      "CreateTransactionDto": {
        "type": "object",
        "properties": {
          "accountId": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "DEBIT",
              "CREDIT",
              "TRANSFER"
            ]
          },
          "amount": {
            "type": "number"
          },
          "currency": {
            "type": "string",
            "default": "DOP"
          },
          "transactionDate": {
            "type": "string"
          },
          "merchant": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "categoryId": {
            "type": "string"
          }
        },
        "required": [
          "accountId",
          "type",
          "amount",
          "transactionDate"
        ]
      },
      "CreateNotificationDto": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "channel": {
            "type": "string",
            "enum": [
              "IN_APP",
              "PUSH",
              "EMAIL"
            ],
            "default": "IN_APP"
          },
          "title": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "data": {
            "type": "object"
          }
        },
        "required": [
          "type",
          "channel",
          "title",
          "body"
        ]
      },
      "RegisterPushTokenDto": {
        "type": "object",
        "properties": {
          "platform": {
            "type": "string",
            "enum": [
              "ios",
              "android"
            ]
          },
          "token": {
            "type": "string"
          }
        },
        "required": [
          "platform",
          "token"
        ]
      },
      "ChatMessageDto": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "user",
              "assistant",
              "system"
            ]
          },
          "content": {
            "type": "string",
            "example": "Resume mis gastos del mes en una frase."
          }
        },
        "required": [
          "role",
          "content"
        ]
      },
      "ChatRequestDto": {
        "type": "object",
        "properties": {
          "sessionId": {
            "type": "string",
            "description": "Optional AI session id to attach metrics"
          },
          "clientMessageId": {
            "type": "string",
            "description": "Client-generated id for idempotent message delivery"
          },
          "messages": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ChatMessageDto"
            }
          }
        },
        "required": [
          "messages"
        ]
      },
      "ChatResponseDto": {
        "type": "object",
        "properties": {
          "sessionId": {
            "type": "string"
          },
          "provider": {
            "type": "string",
            "example": "Groq"
          },
          "model": {
            "type": "string",
            "example": "llama-3.3-70b-versatile"
          },
          "content": {
            "type": "string",
            "example": "Aquí tienes un resumen de tus gastos del mes..."
          },
          "requiresConfirmation": {
            "type": "boolean"
          },
          "actions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "sideEffects": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "blocks": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "sessionId",
          "provider",
          "model",
          "content"
        ]
      },
      "CreateAiSessionDto": {
        "type": "object",
        "properties": {
          "contextType": {
            "type": "string",
            "default": "general"
          },
          "moduleSlug": {
            "type": "string",
            "description": "Module slug to scope the session (agenda, projects, etc.)"
          }
        }
      }
    }
  }
}