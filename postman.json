    {
      "name": "Notifications",
      "description": "Centro in-app, política de preferencias (`channels`, `quietHours`, toggles por módulo) y push tokens.",
      "item": [
        {
          "name": "List notifications",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/{{apiPrefix}}/notifications?channel=IN_APP&page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["{{apiPrefix}}", "notifications"],
              "query": [
                { "key": "channel", "value": "IN_APP", "description": "IN_APP | PUSH | EMAIL" },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" },
                { "key": "unreadOnly", "value": "false", "disabled": true }
              ]
            },
            "description": "Lista paginada. Vacía si `preferences.notifications.channels.inApp` es false."
          },
          "response": []
