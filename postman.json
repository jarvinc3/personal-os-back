          "name": "Get session",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "const data = json.data || json;",
                  "if (data.sub) {",
                  "  pm.collectionVariables.set('userId', data.sub);",
                  "  pm.environment.set('userId', data.sub);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/{{apiPrefix}}/auth/session",
              "host": ["{{baseUrl}}"],
              "path": ["{{apiPrefix}}", "auth", "session"]
            },
            "description": "Devuelve `{ sub, email, role }`. Emite evento `user.logged_in`."
          },
          "response": []
        }
      ]
    },
    {
