              "raw": "{{baseUrl}}/{{apiPrefix}}/notifications",
              "host": ["{{baseUrl}}"],
              "path": ["{{apiPrefix}}", "notifications"]
            },
            "description": "Crea notificación para el usuario autenticado (`@CurrentUser`). Respeta política de preferencias. Emite `notification.new` al room WebSocket."
          },
          "response": []
        },
        {
          "name": "Mark notification as read",
          "request": {
