    },
    {
      "table_name": "fin_cards",
      "name": "fin_cards_last_four_digits_check",
      "definition": "CHECK (((last_four IS NULL) OR (last_four ~ '^[0-9]{4}$'::text)))"
    },
    {
      "table_name": "fin_cards",
      "name": "fin_cards_payment_day_check",
      "definition": "CHECK (((payment_due_day IS NULL) OR ((payment_due_day >= 1) AND (payment_due_day <= 31))))"
    },
    {
      "table_name": "fin_cards",
      "name": "fin_cards_statement_day_check",
      "definition": "CHECK (((statement_closing_day IS NULL) OR ((statement_closing_day >= 1) AND (statement_closing_day <= 31))))"
    },
    {
      "table_name": "fin_cards",
      "name": "fin_cards_type_account_check",
      "definition": "CHECK ((((type = 'DEBIT'::\"FinCardType\") AND (account_id IS NOT NULL)) OR ((type = 'CREDIT'::\"FinCardType\") AND (account_id IS NULL))))"
    },
    {
      "table_name": "fin_institutions",
      "name": "fin_institutions_domain_check",
      "definition": "CHECK (((domain IS NULL) OR (domain ~ '^[a-z0-9.-]+\\.[a-z]{2,}$'::text)))"
    },
    {
      "table_name": "fin_institutions",
      "name": "fin_institutions_type_check",
      "definition": "CHECK ((type = ANY (ARRAY['bank'::text, 'credit_union'::text, 'digital_wallet'::text, 'broker'::text, 'cash'::text, 'other'::text])))"
