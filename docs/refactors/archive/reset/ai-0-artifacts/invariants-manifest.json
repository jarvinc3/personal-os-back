      "table_name": "fin_transactions",
      "name": "fin_transactions_user_inst_ref_key",
      "definition": "CREATE UNIQUE INDEX fin_transactions_user_inst_ref_key ON public.fin_transactions USING btree (user_id, institution_id, external_reference) WHERE ((external_reference IS NOT NULL) AND (status <> 'REVERSED'::\"FinTransactionStatus\"))"
    }
