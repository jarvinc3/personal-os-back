    },
    {
      "table_name": "fin_transactions",
      "name": "fin_transactions_transfer_group_id_idx",
      "definition": "CREATE INDEX fin_transactions_transfer_group_id_idx ON public.fin_transactions USING btree (transfer_group_id) WHERE (transfer_group_id IS NOT NULL)"
    },
