      "definition": "CREATE UNIQUE INDEX fin_accounts_user_institution_default_key ON public.fin_accounts USING btree (user_id, institution_id) WHERE ((is_default_for_institution = true) AND (institution_id IS NOT NULL) AND (is_active = true))"
