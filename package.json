{
  "name": "personal-os-back",
  "version": "0.52.0",
  "description": "Personal OS es un backend para la aplicación Personal OS que permite gestionar cada área de la vida cotidiana.",
  "author": "jarvinc3",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "build:packages": "pnpm -r --filter './packages/*' run build",
    "build": "pnpm db:generate && pnpm build:packages && nest build && pnpm sentry:sourcemaps",
    "format": "prettier --write \"apps/**/*.ts\" \"packages/*/src/**/*.ts\" \"test/**/*.ts\" \"prisma.config.ts\" \"eslint.config.mjs\" \"**/*.md\"",
    "format:check": "prettier --check \"apps/**/*.ts\" \"packages/*/src/**/*.ts\" \"test/**/*.ts\" \"prisma.config.ts\" \"eslint.config.mjs\" \"**/*.md\"",
    "start": "pnpm build:packages && nest start",
    "start:dev": "pnpm build:packages && nest start --watch",
    "start:debug": "pnpm build:packages && nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{apps,packages/*/src,libs,test}/**/*.ts\"",
    "lint:fix": "eslint \"{apps,packages/*/src,libs,test}/**/*.ts\" --fix",
    "lint:money": "node scripts/finance/check-money-decimals.mjs",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json --runInBand",
    "audit:prod": "pnpm audit --prod",
    "db:pull": "prisma db pull",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:status": "prisma migrate status",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:diff": "prisma migrate diff --from-config-datasource --to-schema packages/database/prisma/schema.prisma --script",
    "db:migrate:diff:check": "prisma migrate diff --from-config-datasource --to-schema packages/database/prisma/schema.prisma --exit-code",
    "db:migrate:resolve:applied": "prisma migrate resolve --applied",
    "db:migrate:reset": "prisma migrate reset",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "smoke:finance": "ts-node -r tsconfig-paths/register scripts/finance/smoke-finance-http.ts",
    "sentry:sourcemaps": "node scripts/sentry/upload-sourcemaps.mjs",
    "db:backfill-logos": "ts-node -r tsconfig-paths/register scripts/backfill-institution-logos.ts",
    "db:backfill-loan-schedule": "ts-node -r tsconfig-paths/register scripts/finance/backfill-loan-schedule.ts",
    "db:backfill-goal-allocations": "ts-node -r tsconfig-paths/register scripts/finance/backfill-goal-allocations.ts",
    "db:backfill-budget-spent": "ts-node -r tsconfig-paths/register scripts/finance/backfill-budget-spent.ts",
    "db:backfill-week-starts-on": "ts-node -r tsconfig-paths/register scripts/users/backfill-week-starts-on.ts",
    "db:encrypt-account-numbers": "ts-node -r tsconfig-paths/register -r dotenv/config scripts/finance/encrypt-account-numbers.ts",
    "db:dedupe-existing": "ts-node -r tsconfig-paths/register scripts/finance/dedupe-existing.ts"
  },
  "dependencies": {
    "@bull-board/api": "^7.2.1",
    "@bull-board/express": "^7.2.1",
    "@bull-board/nestjs": "^7.2.1",
    "@cerebras/cerebras_cloud_sdk": "^1.91.0",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/bullmq": "^11.0.5",
    "@nestjs/cache-manager": "^3.1.3",
    "@nestjs/common": "^11.2.7",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.7",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.2.7",
    "@nestjs/platform-socket.io": "^11.2.7",
    "@nestjs/schedule": "^5.0.1",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/websockets": "^11.2.7",
    "@openrouter/sdk": "^0.12.79",
    "@personal-os/ai-agent": "workspace:*",
    "@personal-os/auth": "workspace:*",
    "@personal-os/config": "workspace:*",
    "@personal-os/core": "workspace:*",
    "@personal-os/database": "workspace:*",
    "@personal-os/finance": "workspace:*",
    "@personal-os/logos": "workspace:*",
    "@personal-os/notifications": "workspace:*",
    "@personal-os/users": "workspace:*",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@sentry/nestjs": "11.8.0",
    "@supabase/supabase-js": "^2.118.0",
    "axios": "1.20.0",
    "bullmq": "^5.81.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^17.4.2",
    "groq-sdk": "^1.6.0",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "jwks-rsa": "^4.1.0",
    "nestjs-cls": "^6.3.1",
    "nestjs-pino": "^4.6.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.23.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.4",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.7",
    "@sentry/cli": "3.8.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.5",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.3",
    "@types/web-push": "^3.6.4",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^16.5.0",
    "jest": "^30.5.2",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "prisma": "^7.10.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": "(apps/[^/]+/src|packages/[^/]+/src)/.*\\.spec\\.ts$",
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1",
      "^@personal-os/([^/]+)$": "<rootDir>/packages/$1/src"
    },
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "apps/*/src/**/*.(t|j)s",
      "packages/*/src/**/*.(t|j)s",
      "!**/generated/**",
      "!**/*.module.ts",
      "!**/main.ts"
    ],
    "coverageDirectory": "coverage",
    "coverageThreshold": {
      "global": {
        "statements": 70,
        "lines": 69,
        "functions": 51,
        "branches": 58
      }
    },
    "testEnvironment": "node"
  }
}
