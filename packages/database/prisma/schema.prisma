enum DomainEventOutboxStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  DEAD

  @@map("domain_event_outbox_status")
}

/// Durable domain events published post-commit (transactional outbox).
model DomainEventOutbox {
  id            String                  @id @default(dbgenerated("(uuid_generate_v4())::text"))
  eventId       String                  @unique @map("event_id")
  eventName     String                  @map("event_name")
  aggregateType String                  @map("aggregate_type")
  aggregateId   String                  @map("aggregate_id")
  userId        String?                 @map("user_id")
  payload       Json
  status        DomainEventOutboxStatus @default(PENDING)
  attempts      Int                     @default(0)
  nextAttemptAt DateTime                @default(now()) @map("next_attempt_at") @db.Timestamptz(6)
  lastError     String?                 @map("last_error")
  createdAt     DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  processedAt   DateTime?               @map("processed_at") @db.Timestamptz(6)

  @@index([status, nextAttemptAt], map: "domain_event_outbox_status_next_attempt_idx")
  @@index([userId], map: "domain_event_outbox_user_id_idx")
  @@map("domain_event_outbox")
}

/// Idempotency for domain event consumers.
model ProcessedDomainEvent {
  id           String   @id @default(dbgenerated("(uuid_generate_v4())::text"))
  eventId      String   @map("event_id")
  consumer     String
  processedAt  DateTime @default(now()) @map("processed_at") @db.Timestamptz(6)

  @@unique([eventId, consumer], map: "processed_domain_events_event_consumer_key")
  @@map("processed_domain_events")
}

