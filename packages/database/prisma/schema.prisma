  transaction    FinTransaction?              @relation(fields: [transactionId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@unique([subscriptionId, transactionId], map: "fin_subscription_payments_sub_tx_uq")
  @@index([subscriptionId, paidAt], map: "fin_subscription_payments_sub_paid_idx")
  @@index([transactionId], map: "fin_subscription_payments_transaction_id_idx")
  @@map("fin_subscription_payments")
}

/// One row per alert the user dismissed, so it never comes back for that date.
model FinSubscriptionAlertDismissal {
  id             String                   @id @default(dbgenerated("(uuid_generate_v4())::text"))
  userId         String                   @map("user_id")
  subscriptionId String                   @map("subscription_id")
  kind           FinSubscriptionAlertKind
  alertDate      DateTime                 @map("alert_date") @db.Date
  createdAt      DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  subscription   FinSubscription          @relation(fields: [subscriptionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user           User                     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([subscriptionId, kind, alertDate], map: "fin_subscription_alert_dismissals_uq")
  @@index([userId], map: "fin_subscription_alert_dismissals_user_idx")
  @@map("fin_subscription_alert_dismissals")
}

model FinExchangeRate {
  id           String   @id @default(dbgenerated("(uuid_generate_v4())::text"))
  fromCurrency String   @map("from_currency")
  toCurrency   String   @map("to_currency")
  rate         Decimal  @db.Decimal(15, 6)
  rateDate     DateTime @map("rate_date") @db.Date
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([fromCurrency, toCurrency, rateDate], map: "fin_exchange_rates_from_to_date_key")
  @@index([fromCurrency, toCurrency], map: "fin_exchange_rates_from_to_idx")
  @@map("fin_exchange_rates")
}

model FinInstitution {
  id             String           @id @default(dbgenerated("(uuid_generate_v4())::text"))
  userId         String           @map("user_id")
  name           String
  /// bank | credit_union | digital_wallet | broker | cash | other
  type           String           @default("bank")
  shortName      String?          @map("short_name")
  sortOrder      Int              @default(0) @map("sort_order")
  domain         String?
  logoPath       String?          @map("logo_path")
  customLogoPath String?          @map("custom_logo_path")
  /// Legacy external URL. Response logoUrl prefers customLogoPath, then logoPath.
  logoUrl        String?          @map("logo_url")
  color          String?
  country        String           @default("DO")
  isActive       Boolean          @default(true) @map("is_active")
  /// System institutions (the user's "Efectivo") cannot be renamed, archived or deleted.
  isSystem       Boolean          @default(false) @map("is_system")
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  accounts       FinAccount[]
  cards          FinCard[]
  emailSources   FinEmailSource[]
  loans          FinLoan[]
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId, isActive], map: "fin_institutions_user_id_active_idx")
  @@index([userId, name], map: "fin_institutions_user_id_name_idx")
  @@map("fin_institutions")
}

model FinCard {
  id                  String               @id @default(dbgenerated("(uuid_generate_v4())::text"))
  userId              String               @map("user_id")
  institutionId       String               @map("institution_id")
  accountId           String?              @map("account_id")
  name                String
  lastFour            String?              @map("last_four")
  type                FinCardType
  network             FinCardNetwork?
  statementClosingDay Int?                 @map("statement_closing_day")
  paymentDueDay       Int?                 @map("payment_due_day")
  color               String?
  isActive            Boolean              @default(true) @map("is_active")
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  account             FinAccount?          @relation(fields: [accountId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  balances            FinCardBalance[]
