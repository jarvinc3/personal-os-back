/// Async cleanup of Supabase Auth after app-row deletion.
/// No FK to users — the user row is removed in the same transaction that creates this outbox entry.
enum AuthDeletionOutboxStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
  DEAD

  @@map("auth_deletion_outbox_status")
}

model AuthDeletionOutbox {
  id            String                   @id @default(dbgenerated("(uuid_generate_v4())::text"))
  userId        String                   @unique @map("user_id")
  status        AuthDeletionOutboxStatus @default(PENDING)
  attempts      Int                      @default(0)
  nextAttemptAt DateTime                 @default(now()) @map("next_attempt_at") @db.Timestamptz(6)
  lastError     String?                  @map("last_error")
  completedAt   DateTime?                @map("completed_at") @db.Timestamptz(6)
  createdAt     DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status, nextAttemptAt], map: "auth_deletion_outbox_status_next_attempt_idx")
  @@map("auth_deletion_outbox")
}
