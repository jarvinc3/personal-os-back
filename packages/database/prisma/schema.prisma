generator client {
  provider     = "prisma-client"
  output       = "../src/generated"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                             String                          @id @default(dbgenerated("(uuid_generate_v4())::text"))
  email                          String                          @unique
  fullName                       String                          @map("full_name")
  avatarUrl                      String?                         @map("avatar_url")
  timezone                       String                          @default("America/Santo_Domingo")
  locale                         String                          @default("es-DO")
  preferences                    Json                            @default("{}")
  lastSeenReleaseVersion         String?                         @map("last_seen_release_version")
  createdAt                      DateTime                        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                      DateTime                        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  aiSessions                     AiAgentSession[]
  aiActions                      AiAction[]
  finAccounts                    FinAccount[]
  finCards                       FinCard[]
  finInstitutions                FinInstitution[]
  finBudgets                     FinBudget[]
  finCategories                  FinCategory[]
  finMerchants                   FinMerchant[]
  finSubscriptions               FinSubscription[]
  finSubscriptionAlertDismissals FinSubscriptionAlertDismissal[]
  finEmailConnections            FinEmailConnection[]
  finEmailSources                FinEmailSource[]
  finLoans                       FinLoan[]
  finReceivables                 FinReceivable[]
  finReceivableShares            FinReceivableShare[]
  finRecurring                   FinRecurringPattern[]
  finSavingsGoals                FinSavingsGoal[]
  finTransactions                FinTransaction[]
  finDeletionJournal             FinDeletionJournal[]
  finInstrumentEvents            FinInstrumentEvent[]
  finStatementImports            FinStatementImport[]
  finReconciliations             FinReconciliation[]
  finBalanceDrifts               FinBalanceDrift[]
  notifications                  Notification[]
  pushTokens                     PushToken[]
  userModules                    UserModule[]
  idempotencyKeys                IdempotencyKey[]

  @@map("users")
}

model Module {
  id          String           @id @default(dbgenerated("(uuid_generate_v4())::text"))
  slug        String           @unique
  name        String
  isActive    Boolean          @default(true) @map("is_active")
  sortOrder   Int              @default(0) @map("sort_order")
  key         String           @unique
  description String?
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  aiSessions  AiAgentSession[]
  userModules UserModule[]

  @@map("modules")
}

model UserModule {
  id        String   @id @default(dbgenerated("(uuid_generate_v4())::text"))
  userId    String   @map("user_id")
  moduleId  String   @map("module_id")
  isEnabled Boolean  @default(true) @map("is_enabled")
  config    Json     @default("{}")
  enabledAt DateTime @default(now()) @map("enabled_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  module    Module   @relation(fields: [moduleId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, moduleId])
  @@index([moduleId], map: "user_modules_module_id_idx")
  @@map("user_modules")
}

model AiAgentSession {
  id             String      @id @default(dbgenerated("(uuid_generate_v4())::text"))
  userId         String      @map("user_id")
  moduleId       String?     @map("module_id")
  contextType    String      @default("general") @map("context_type")
  chatContext    Json        @default("{}") @map("chat_context")
  memorySnapshot Json        @default("{}") @map("memory_snapshot")
  lastActiveAt   DateTime    @default(now()) @map("last_active_at") @db.Timestamptz(6)
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  actions        AiAction[]
  module         Module?     @relation(fields: [moduleId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  messages       AiMessage[]

  @@index([userId, lastActiveAt], map: "ai_agent_sessions_user_id_last_active_idx")
  @@index([moduleId], map: "ai_agent_sessions_module_id_idx")
  @@map("ai_agent_sessions")
}

model AiMessage {
  id              String         @id @default(dbgenerated("(uuid_generate_v4())::text"))
  sessionId       String         @map("session_id")
  role            AiRole
  content         String
  clientMessageId String?        @map("client_message_id")
  toolCalls       Json?          @map("tool_calls")
  metadata        Json           @default("{}")
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  actions         AiAction[]
  session         AiAgentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([sessionId, role, clientMessageId])
  @@index([sessionId, clientMessageId])
  @@map("ai_messages")
}

model AiAction {
  id           String         @id @default(dbgenerated("(uuid_generate_v4())::text"))
  sessionId    String         @map("session_id")
  userId       String         @map("user_id")
  messageId    String?        @map("message_id")
  actionType   String         @map("action_type")
  targetModule String         @map("target_module")
  payload      Json
  status       AiActionStatus @default(PENDING)
  result       Json?
  executedAt   DateTime?      @map("executed_at") @db.Timestamptz(6)
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  message      AiMessage?     @relation(fields: [messageId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  session      AiAgentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([sessionId], map: "ai_actions_session_id_idx")
  @@index([userId], map: "ai_actions_user_id_idx")
  @@index([messageId], map: "ai_actions_message_id_idx")
  @@map("ai_actions")
}

model Notification {
  id          String              @id @default(dbgenerated("(uuid_generate_v4())::text"))
  userId      String              @map("user_id")
  type        String
  channel     NotificationChannel
  title       String
  body        String
  data        Json                @default("{}")
  isRead      Boolean             @default(false) @map("is_read")
  scheduledAt DateTime?           @map("scheduled_at") @db.Timestamptz(6)
  sentAt      DateTime?           @map("sent_at") @db.Timestamptz(6)
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId, isRead])
  @@index([scheduledAt])
  @@map("notifications")
}

model PushToken {
  id        String   @id @default(dbgenerated("(uuid_generate_v4())::text"))
  userId    String   @map("user_id")
  platform  String
  token     String   @unique
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId], map: "push_tokens_user_id_idx")
  @@map("push_tokens")
}

model FinAccount {
  id                         String                       @id @default(dbgenerated("(uuid_generate_v4())::text"))
  userId                     String                       @map("user_id")
  /// Required for CHECKING/SAVINGS/INVESTMENT. Null only for CASH (DB check).
  institutionId              String?                      @map("institution_id")
  name                       String
  type                       FinAccountType
  /// Bank account number encrypted at rest (AES-256-GCM, DATA_ENCRYPTION_KEY). Null for CASH and legacy rows.
  accountNumber              String?                      @map("account_number")
  /// Last four digits for display and email matching, kept out of the ciphertext.
  accountNumberLast4         String?                      @map("account_number_last4")
  /// HMAC-SHA256 of the account number with DATA_ENCRYPTION_KEY; enforces one account per number.
  accountNumberHash          String?                      @map("account_number_hash")
  /// Fallback ledger target for this institution when an email has no account digits.
  isDefaultForInstitution    Boolean                      @default(false) @map("is_default_for_institution")
  currency                   String                       @default("DOP")
  balance                    Decimal                      @default(0) @db.Decimal(15, 2)
  color                      String?
  isActive                   Boolean                      @default(true) @map("is_active")
  createdAt                  DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                  DateTime                     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  user                       User                         @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  institutionRef             FinInstitution?              @relation(fields: [institutionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  cards                      FinCard[]
  transactions               FinTransaction[]
  finLoans                   FinLoan[]
  loanDisbursements          FinLoan[]                    @relation("LoanDisbursementAccount")
  goalWithdrawalDestinations FinSavingsGoalContribution[] @relation("GoalWithdrawalDestination")
  subscriptions              FinSubscription[]
  receivablePayments         FinReceivablePayment[]
  savingsGoalContributions   FinSavingsGoalContribution[]
  savingsGoals               FinSavingsGoal[]
  instrumentEvents           FinInstrumentEvent[]
  statementImports           FinStatementImport[]
  reconciliations            FinReconciliation[]
  balanceDrifts              FinBalanceDrift[]

  @@unique([userId, institutionId, accountNumberHash], map: "fin_accounts_user_institution_number_hash_key")
  @@index([userId, isActive], map: "fin_accounts_user_id_active_idx")
  @@index([institutionId], map: "fin_accounts_institution_id_idx")
  @@index([userId, institutionId, isDefaultForInstitution], map: "fin_accounts_user_institution_default_idx")
  @@map("fin_accounts")
}

/// One Gmail/IMAP inbox (OAuth tokens). Shared by every bank watched on that mailbox.
model FinEmailConnection {
  id             String           @id @default(dbgenerated("(uuid_generate_v4())::text"))
  userId         String           @map("user_id")
  provider       String
  emailAddress   String           @map("email_address")
  accessToken    String?          @map("access_token")
  refreshToken   String?          @map("refresh_token")
  imapHost       String?          @map("imap_host")
  tokenExpiresAt DateTime?        @map("token_expires_at") @db.Timestamptz(6)
  isActive       Boolean          @default(true) @map("is_active")
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  sources        FinEmailSource[]

  @@unique([userId, provider, emailAddress], map: "fin_email_connections_user_provider_email_key")
  @@index([userId, isActive], map: "fin_email_connections_user_id_active_idx")
  @@map("fin_email_connections")
}

/// Bank sender filter on a connection. Not a ledger target and not OAuth.
/// `bankDomain` is derived from `bankSenderEmails` when set; used as Gmail `from:` fallback.
model FinEmailSource {
  id               String             @id @default(dbgenerated("(uuid_generate_v4())::text"))
  userId           String             @map("user_id")
  connectionId     String             @map("connection_id")
  institutionId    String             @map("institution_id")
  /// Allowlisted From addresses for this institution. Gmail query is `from:(a OR b)`.
  bankSenderEmails String[]           @default([]) @map("bank_sender_emails")
  bankDomain       String             @map("bank_domain")
  label            String?
  lastSyncedAt     DateTime?          @map("last_synced_at") @db.Timestamptz(6)
  lastMessageId    String?            @map("last_message_id")
  isActive         Boolean            @default(true) @map("is_active")
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  logs             FinEmailSyncLog[]
  emailMessages    FinEmailMessage[]
  connection       FinEmailConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  institution      FinInstitution     @relation(fields: [institutionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([connectionId, institutionId], map: "fin_email_sources_connection_institution_key")
  @@unique([userId, institutionId], map: "fin_email_sources_user_institution_key")
  @@index([userId, isActive], map: "fin_email_sources_user_id_active_idx")
  @@index([institutionId], map: "fin_email_sources_institution_id_idx")
  @@index([connectionId], map: "fin_email_sources_connection_id_idx")
  @@map("fin_email_sources")
}

enum FinOperationLegRole {
  SOURCE
  DESTINATION
  FEE

  @@map("fin_operation_leg_role")
}

enum FinTransferRail {
  SAME_BANK
  ACH
  LBTR
  OTHER

  @@map("fin_transfer_rail")
}

model FinTransaction {
  id                       String                       @id @default(dbgenerated("(uuid_generate_v4())::text"))
  accountId                String?                      @map("account_id")
  cardId                   String?                      @map("card_id")
  userId                   String                       @map("user_id")
  categoryId               String?                      @map("category_id")
  /// FK to FinEmailMessage.id. Gmail's provider id lives on FinEmailMessage.gmailMessageId.
  emailMessageId           String?                      @unique @map("email_message_id")
  /// Bank reference / authorization code from the source email; dedupes re-sent notices.
  externalReference        String?                      @map("external_reference")
  /// Denormalized institution, for the idempotency index.
  institutionId            String?                      @map("institution_id")
  possibleDuplicateOfId    String?                      @map("possible_duplicate_of_id")
  type                     FinTransactionType
  /// Original amount in source currency (e.g. as shown on bank email).
  amount                   Decimal                      @db.Decimal(15, 2)
  /// Amount applied to ledger target balance (account currency / card balance currency).
  ledgerAmount             Decimal                      @map("ledger_amount") @db.Decimal(15, 2)
  amountBaseCurrency       Decimal                      @map("amount_base_currency") @db.Decimal(15, 2)
  /// Original / transaction currency (ISO 4217).
  currency                 String                       @default("DOP")
  /// Currency of ledgerAmount.
  ledgerCurrency           String                       @default("DOP") @map("ledger_currency")
  /// Rate used for original → ledger conversion (1 when same currency).
  exchangeRate             Decimal                      @default(1) @map("exchange_rate") @db.Decimal(18, 8)
  /// Transfer rate came from the market quote instead of a received amount or a user rate.
  isEstimated              Boolean                      @default(false) @map("is_estimated")
  merchant                 String?
  /// Canonical merchant resolved from `merchant`; `merchant` keeps the raw text.
  merchantId               String?                      @map("merchant_id")
  description              String?
  transactionDate          DateTime                     @map("transaction_date") @db.Timestamptz(6)
  transferGroupId          String?                      @map("transfer_group_id")
  linkedTransactionId      String?                      @map("linked_transaction_id")
  status                   FinTransactionStatus         @default(CONFIRMED)
  isRecurring              Boolean                      @default(false) @map("is_recurring")
  aiMetadata               Json                         @default("{}") @map("ai_metadata")
  notes                    String?
  source                   FinTransactionSource         @default(MANUAL)
  /// Role of this row inside a multi-leg operation (transfer, fee).
  legRole                  FinOperationLegRole?         @map("leg_role")
  /// Interbank rail for a transfer; the UI estimates the arrival time.
  rail                     FinTransferRail?
  createdAt                DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime                     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  account                  FinAccount?                  @relation(fields: [accountId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  card                     FinCard?                     @relation(fields: [cardId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  category                 FinCategory?                 @relation(fields: [categoryId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  merchantRef              FinMerchant?                 @relation(fields: [merchantId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  emailMessage             FinEmailMessage?             @relation(fields: [emailMessageId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  user                     User                         @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  linkedTransaction        FinTransaction?              @relation("TransactionLink", fields: [linkedTransactionId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  linkedFrom               FinTransaction[]             @relation("TransactionLink")
  receivablePayment        FinReceivablePayment?
  subscriptionPayments     FinSubscriptionPayment[]
  savingsGoalContribution  FinSavingsGoalContribution?
  loanDisbursement         FinLoan?                     @relation("LoanDisbursementTransaction")
  loanInstallment          FinLoanInstallment?
  loanPrepayment           FinLoanPrepayment?
  statementImportLines     FinStatementImportLine[]
  reconciliationAdjustment FinReconciliationAdjustment?

  @@index([accountId, transactionDate], map: "fin_transactions_account_id_date_idx")
  @@index([cardId, transactionDate], map: "fin_transactions_card_id_date_idx")
  @@index([userId, categoryId], map: "fin_transactions_user_id_category_idx")
  @@index([merchantId], map: "fin_transactions_merchant_id_idx")
  @@index([userId, transactionDate], map: "fin_transactions_user_id_date_idx")
  @@index([userId, status, transactionDate], map: "fin_transactions_user_status_date_idx")
  @@index([userId, externalReference], map: "fin_transactions_user_ref_idx")
  @@index([transferGroupId], map: "fin_transactions_transfer_group_id_idx")
  @@index([categoryId], map: "fin_transactions_category_id_idx")
  @@index([linkedTransactionId], map: "fin_transactions_linked_transaction_id_idx")
  @@map("fin_transactions")
}

model FinCategory {
  id               String                @id @default(dbgenerated("(uuid_generate_v4())::text"))
  userId           String?               @map("user_id")
  name             String
  icon             String?
  color            String?
  parentId         String?               @map("parent_id")
  isSystem         Boolean               @default(false) @map("is_system")
  systemKind       String?               @map("system_kind")
  type             FinCategoryType       @default(EXPENSE)
  createdAt        DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  budgets          FinBudget[]
  budgetCategories FinBudgetCategory[]
  parent           FinCategory?          @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  children         FinCategory[]         @relation("CategoryHierarchy")
  user             User?                 @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  recurring        FinRecurringPattern[]
  merchants        FinMerchant[]
  transactions     FinTransaction[]
  subscriptions    FinSubscription[]

  @@index([userId], map: "fin_categories_user_id_idx")
  @@index([parentId], map: "fin_categories_parent_id_idx")
  @@index([userId, type], map: "fin_categories_user_id_type_idx")
  @@map("fin_categories")
}

model FinBudget {
  id                  String              @id @default(dbgenerated("(uuid_generate_v4())::text"))
  userId              String              @map("user_id")
  categoryId          String?             @map("category_id")
  name                String?
  includeChildren     Boolean             @default(true) @map("include_children")
  rollover            FinBudgetRollover   @default(NONE)
  carriedOver         Decimal             @default(0) @map("carried_over") @db.Decimal(15, 2)
  recurring           Boolean             @default(false)
  periodType          FinBudgetPeriodType @default(MONTHLY) @map("period_type")
  periodStart         DateTime            @map("period_start") @db.Date
  periodEnd           DateTime            @map("period_end") @db.Date
  amountLimit         Decimal             @map("amount_limit") @db.Decimal(15, 2)
  amountSpent         Decimal             @default(0) @map("amount_spent") @db.Decimal(15, 2)
  alertThresholdPct   Decimal             @default(80) @map("alert_threshold_pct") @db.Decimal(5, 2)
  aiSuggestionStatus  AiSuggestionStatus  @default(NONE) @map("ai_suggestion_status")
  aiSuggestionPayload Json?               @map("ai_suggestion_payload")
  createdAt           DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  alerts              FinBudgetAlert[]
  category            FinCategory?        @relation(fields: [categoryId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  categories          FinBudgetCategory[]
  user                User                @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, categoryId, periodStart], map: "fin_budgets_user_category_period_key")
  @@index([userId, periodType, periodStart], map: "fin_budgets_user_period_idx")
  @@index([categoryId], map: "fin_budgets_category_id_idx")
  @@map("fin_budgets")
}

enum FinBudgetRollover {
  NONE
  SURPLUS
  SURPLUS_AND_DEFICIT

  @@map("fin_budget_rollover")
}

model FinBudgetCategory {
  budgetId   String      @map("budget_id")
  categoryId String      @map("category_id")
  budget     FinBudget   @relation(fields: [budgetId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  category   FinCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([budgetId, categoryId])
  @@index([categoryId], map: "fin_budget_categories_category_id_idx")
  @@map("fin_budget_categories")
}

model FinBudgetAlert {
  id          String    @id @default(dbgenerated("(uuid_generate_v4())::text"))
  budgetId    String    @map("budget_id")
  type        String
  pctUsed     Decimal   @map("pct_used") @db.Decimal(5, 2)
  wasNotified Boolean   @default(false) @map("was_notified")
  triggeredAt DateTime  @default(now()) @map("triggered_at") @db.Timestamptz(6)
  budget      FinBudget @relation(fields: [budgetId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([budgetId, type], map: "fin_budget_alerts_budget_id_type_key")
  @@index([budgetId], map: "fin_budget_alerts_budget_id_idx")
  @@map("fin_budget_alerts")
}

model FinRecurringPattern {
  id               String             @id @default(dbgenerated("(uuid_generate_v4())::text"))
  userId           String             @map("user_id")
  categoryId       String?            @map("category_id")
  merchantId       String?            @map("merchant_id")
  merchant         String
  avgAmount        Decimal            @map("avg_amount") @db.Decimal(15, 2)
  currency         String             @default("DOP")
  frequency        String
  nextExpectedDate DateTime           @map("next_expected_date") @db.Date
  /// Percentage band around avgAmount that still counts as the same charge.
  amountTolerance  Decimal            @default(10) @map("amount_tolerance") @db.Decimal(5, 2)
  status           FinRecurringStatus @default(SUGGESTED)
  kind             FinRecurringKind   @default(SUBSCRIPTION)
  confidenceScore  Int                @default(0) @map("confidence_score")
  /// Last movement date seen for this pattern; drives "no llegó".
  lastSeenAt       DateTime?          @map("last_seen_at") @db.Timestamptz(6)
  /// When the user confirmed, so a confirmed annual survives with 2 charges.
  confirmedAt      DateTime?          @map("confirmed_at") @db.Timestamptz(6)
  aiAnalysis       Json               @default("{}") @map("ai_analysis")
  isActive         Boolean            @default(true) @map("is_active")
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  category         FinCategory?       @relation(fields: [categoryId], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "fin_recurring_patterns_category_fkey")
  merchantRef      FinMerchant?       @relation(fields: [merchantId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  subscriptions    FinSubscription[]

  @@index([userId], map: "fin_recurring_patterns_user_id_idx")
  @@index([categoryId], map: "fin_recurring_patterns_category_id_idx")
  @@index([userId, status], map: "fin_recurring_patterns_user_status_idx")
  @@index([userId, nextExpectedDate], map: "fin_recurring_patterns_user_next_date_idx")
  @@map("fin_recurring_patterns")
}

model FinMerchant {
  id             String                     @id @default(dbgenerated("(uuid_generate_v4())::text"))
  userId         String                     @map("user_id")
  name           String
  /// Normalized lookup key: unique per user.
  normalizedKey  String                     @map("normalized_key")
  /// Raw merchant strings that map to this merchant.
  aliases        String[]                   @default([])
  categoryId     String?                    @map("category_id")
  /// Where the category came from: set by hand, learned from movements or guessed by keywords.
  categorySource FinMerchantCategorySource? @map("category_source")
  logoUrl        String?                    @map("logo_url")
  createdAt      DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  user           User                       @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  category       FinCategory?               @relation(fields: [categoryId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  transactions   FinTransaction[]
  recurring      FinRecurringPattern[]

  @@unique([userId, normalizedKey], map: "fin_merchants_user_normalized_key_uq")
  @@index([userId], map: "fin_merchants_user_id_idx")
  @@index([categoryId], map: "fin_merchants_category_id_idx")
  @@map("fin_merchants")
}

model FinSubscription {
  id                 String                          @id @default(dbgenerated("(uuid_generate_v4())::text"))
  userId             String                          @map("user_id")
  name               String
  /// Normalized merchant key used by the payment matcher.
  normalizedKey      String                          @map("normalized_key")
  domain             String?
  logoPath           String?                         @map("logo_path")
  customLogoPath     String?                         @map("custom_logo_path")
  amount             Decimal                         @db.Decimal(15, 2)
  currency           String                          @default("DOP")
  billingCycle       FinBillingCycle                 @map("billing_cycle")
  billingInterval    Int                             @default(1) @map("billing_interval")
  /// First charge; every next date is derived from this anchor.
  anchorDate         DateTime                        @map("anchor_date") @db.Date
  nextBillingDate    DateTime                        @map("next_billing_date") @db.Date
  trialEndsAt        DateTime?                       @map("trial_ends_at") @db.Date
  status             FinSubscriptionStatus           @default(ACTIVE)
  pausedAt           DateTime?                       @map("paused_at") @db.Timestamptz(6)
  cancelledAt        DateTime?                       @map("cancelled_at") @db.Timestamptz(6)
  reminderDaysBefore Int                             @default(3) @map("reminder_days_before")
  /// Last nextBillingDate already notified; avoids duplicate reminders.
  lastRemindedFor    DateTime?                       @map("last_reminded_for") @db.Date
  cardId             String?                         @map("card_id")
  accountId          String?                         @map("account_id")
  categoryId         String?                         @map("category_id")
  manageUrl          String?                         @map("manage_url")
  notes              String?
  sourcePatternId    String?                         @map("source_pattern_id")
  createdAt          DateTime                        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  account            FinAccount?                     @relation(fields: [accountId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  card               FinCard?                        @relation(fields: [cardId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  category           FinCategory?                    @relation(fields: [categoryId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  sourcePattern      FinRecurringPattern?            @relation(fields: [sourcePatternId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  user               User                            @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  payments           FinSubscriptionPayment[]
  alertDismissals    FinSubscriptionAlertDismissal[]

  @@index([userId, status], map: "fin_subscriptions_user_status_idx")
  @@index([userId, nextBillingDate], map: "fin_subscriptions_user_next_billing_idx")
  @@index([cardId], map: "fin_subscriptions_card_id_idx")
  @@index([accountId], map: "fin_subscriptions_account_id_idx")
  @@index([categoryId], map: "fin_subscriptions_category_id_idx")
  @@index([sourcePatternId], map: "fin_subscriptions_source_pattern_id_idx")
  @@map("fin_subscriptions")
}

model FinSubscriptionPayment {
  id             String                       @id @default(dbgenerated("(uuid_generate_v4())::text"))
  subscriptionId String                       @map("subscription_id")
  transactionId  String?                      @map("transaction_id")
