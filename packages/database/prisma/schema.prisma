}

model FinCardBalance {
  id          String   @id @default(dbgenerated("(uuid_generate_v4())::text"))
  cardId      String   @map("card_id")
  currency    String
  balance     Decimal  @default(0) @db.Decimal(15, 2)
  creditLimit Decimal? @map("credit_limit") @db.Decimal(15, 2)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  card        FinCard  @relation(fields: [cardId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([cardId, currency], map: "fin_card_balances_card_id_currency_key")
  @@map("fin_card_balances")
}

/// Instrument timeline row (limit change, adjustment, closed statement).
/// Adjustments also live in FinTransaction; the history query unions both.
model FinInstrumentEvent {
  id        String      @id @default(dbgenerated("(uuid_generate_v4())::text"))
  userId    String      @map("user_id")
  accountId String?     @map("account_id")
  cardId    String?     @map("card_id")
  kind      String
  payload   Json        @default("{}")
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  account   FinAccount? @relation(fields: [accountId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  card      FinCard?    @relation(fields: [cardId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([accountId, createdAt], map: "fin_instrument_events_account_created_idx")
  @@index([cardId, createdAt], map: "fin_instrument_events_card_created_idx")
  @@map("fin_instrument_events")
}

/// Immutable closing snapshot. Paid amount and status are derived from the
/// ledger on read, so a stale row can never misreport a payment.
model FinCardStatement {
  id               String                 @id @default(dbgenerated("(uuid_generate_v4())::text"))
  cardId           String                 @map("card_id")
  currency         String
  cycleStart       DateTime               @map("cycle_start") @db.Date
  cycleEnd         DateTime               @map("cycle_end") @db.Date
  dueDate          DateTime?              @map("due_date") @db.Date
  closingBalance   Decimal                @map("closing_balance") @db.Decimal(15, 2)
  minimumPayment   Decimal?               @map("minimum_payment") @db.Decimal(15, 2)
  minimumSource    FinAmountSource?       @map("minimum_source")
  status           FinCardStatementStatus @default(CLOSED)
  importedAt       DateTime?              @map("imported_at") @db.Timestamptz(6)
  createdAt        DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  card             FinCard                @relation(fields: [cardId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  statementImports FinStatementImport[]

  @@unique([cardId, currency, cycleEnd], map: "fin_card_statements_card_currency_cycle_key")
  @@index([cardId, cycleEnd], map: "fin_card_statements_card_id_cycle_end_idx")
  @@map("fin_card_statements")
}

enum FinCardStatementStatus {
  OPEN
  CLOSED
  PARTIAL
  MINIMUM_PAID
  PAID
  OVERDUE

  @@map("fin_card_statement_status")
}

enum FinAmountSource {
  IMPORTED
  ESTIMATED
  MANUAL

  @@map("fin_amount_source")
}

model FinSavingsGoal {
  id                   String                       @id @default(dbgenerated("(uuid_generate_v4())::text"))
  userId               String                       @map("user_id")
  name                 String
  description          String?
  targetAmount         Decimal                      @map("target_amount") @db.Decimal(15, 2)
  currentAmount        Decimal                      @default(0) @map("current_amount") @db.Decimal(15, 2)
  currency             String                       @default("DOP")
  targetDate           DateTime?                    @map("target_date") @db.Date
  icon                 String?
  color                String?
  accountId            String?                      @map("account_id")
  mode                 FinGoalMode                  @default(EARMARK)
  spendReducesProgress Boolean                      @default(true) @map("spend_reduces_progress")
  isCompleted          Boolean                      @default(false) @map("is_completed")
  completedAt          DateTime?                    @map("completed_at") @db.Timestamptz(6)
  createdAt            DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime                     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  account              FinAccount?                  @relation(fields: [accountId], references: [id], onDelete: SetNull)
  user                 User                         @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  contributions        FinSavingsGoalContribution[]

  @@index([userId, isCompleted], map: "fin_savings_goals_user_id_completed_idx")
  @@index([accountId], map: "fin_savings_goals_account_id_idx")
  @@map("fin_savings_goals")
}

enum FinGoalMode {
  EARMARK
  DEDICATED

  @@map("fin_goal_mode")
}

enum FinAllocationKind {
  CONTRIBUTION
  WITHDRAWAL

  @@map("fin_allocation_kind")
}

/// One amount set aside for a savings goal. The goal balance is the sum of its
/// contributions; the money is not moved between accounts.
model FinSavingsGoalContribution {
  id                   String            @id @default(dbgenerated("(uuid_generate_v4())::text"))
  goalId               String            @map("goal_id")
  amount               Decimal           @db.Decimal(15, 2)
  contributedAt        DateTime          @map("contributed_at") @db.Date
  /// Account the money left. Null only after that account is deleted.
  accountId            String?           @map("account_id")
  /// Account that received a withdrawal; null for a contribution.
  destinationAccountId String?           @map("destination_account_id")
  transactionId        String?           @unique @map("transaction_id")
  kind                 FinAllocationKind @default(CONTRIBUTION)
  transferGroupId      String?           @map("transfer_group_id")
  notes                String?
  createdAt            DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  account              FinAccount?       @relation(fields: [accountId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  destinationAccount   FinAccount?       @relation("GoalWithdrawalDestination", fields: [destinationAccountId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  goal                 FinSavingsGoal    @relation(fields: [goalId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  transaction          FinTransaction?   @relation(fields: [transactionId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([goalId, contributedAt], map: "fin_savings_goal_contributions_goal_id_date_idx")
  @@index([accountId], map: "fin_savings_goal_contributions_account_id_idx")
  @@index([destinationAccountId], map: "fin_savings_goal_contributions_destination_account_id_idx")
  @@map("fin_savings_goal_contributions")
}

model FinLoan {
  id                        String               @id @default(dbgenerated("(uuid_generate_v4())::text"))
  userId                    String               @map("user_id")
  institutionId             String?              @map("institution_id")
  accountId                 String?              @map("account_id")
  /// Optional alias that distinguishes loans from the same lender.
  name                      String?
  lenderName                String               @map("lender_name")
  originalAmount            Decimal              @map("original_amount") @db.Decimal(15, 2)
  currentBalance            Decimal              @map("current_balance") @db.Decimal(15, 2)
  currency                  String               @default("DOP")
  installmentAmount         Decimal              @map("installment_amount") @db.Decimal(15, 2)
  installmentFreq           FinInstallmentFreq   @map("installment_freq")
  totalInstallments         Int                  @map("total_installments")
  paidInstallments          Int                  @default(0) @map("paid_installments")
  nextDueDate               DateTime             @map("next_due_date") @db.Date
  interestRate              Decimal?             @map("interest_rate") @db.Decimal(5, 4)
  rateType                  FinRateType          @default(FIXED) @map("rate_type")
  insuranceAmount           Decimal?             @map("insurance_amount") @db.Decimal(15, 2)
  lateFeePolicy             Json?                @map("late_fee_policy")
  prepaymentPenaltyPct      Decimal?             @map("prepayment_penalty_pct") @db.Decimal(5, 4)
  disbursementDate          DateTime?            @map("disbursement_date") @db.Date
  /// Account that received the disbursed principal; null when it was not recorded.
  disbursementAccountId     String?              @map("disbursement_account_id")
  /// Movement that credited the disbursed principal to the account.
  disbursementTransactionId String?              @unique @map("disbursement_transaction_id")
  notes                     String?
  isActive                  Boolean              @default(true) @map("is_active")
  createdAt                 DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  account                   FinAccount?          @relation(fields: [accountId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  disbursementAccount       FinAccount?          @relation("LoanDisbursementAccount", fields: [disbursementAccountId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  disbursementTransaction   FinTransaction?      @relation("LoanDisbursementTransaction", fields: [disbursementTransactionId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  institution               FinInstitution?      @relation(fields: [institutionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  installments              FinLoanInstallment[]
  prepayments               FinLoanPrepayment[]
  user                      User                 @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId, isActive, nextDueDate], map: "fin_loans_user_id_active_due_idx")
  @@index([accountId], map: "fin_loans_account_id_idx")
  @@index([disbursementAccountId], map: "fin_loans_disbursement_account_id_idx")
  @@index([institutionId], map: "fin_loans_institution_id_idx")
  @@map("fin_loans")
}

/// One scheduled loan instalment. paidAt null means unpaid; amount is the scheduled
/// instalment and does not change when the loan balance is adjusted.
model FinLoanInstallment {
  id            String               @id @default(dbgenerated("(uuid_generate_v4())::text"))
  loanId        String               @map("loan_id")
  installmentNo Int                  @map("installment_no")
  dueDate       DateTime             @map("due_date") @db.Date
  amount        Decimal              @db.Decimal(15, 2)
  principal     Decimal              @default(0) @db.Decimal(15, 2)
  interest      Decimal              @default(0) @db.Decimal(15, 2)
  insurance     Decimal              @default(0) @db.Decimal(15, 2)
  fees          Decimal              @default(0) @db.Decimal(15, 2)
  lateFee       Decimal              @default(0) @map("late_fee") @db.Decimal(15, 2)
  paidAmount    Decimal              @default(0) @map("paid_amount") @db.Decimal(15, 2)
  status        FinInstallmentStatus @default(PENDING)
  paidAt        DateTime?            @map("paid_at") @db.Timestamptz(6)
  /// Movement created when the instalment was paid; null when it was not recorded.
  transactionId String?              @unique @map("transaction_id")
  createdAt     DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  loan          FinLoan              @relation(fields: [loanId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  transaction   FinTransaction?      @relation(fields: [transactionId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@unique([loanId, installmentNo], map: "fin_loan_installments_loan_no_key")
  @@index([loanId, dueDate], map: "fin_loan_installments_loan_id_due_idx")
  @@map("fin_loan_installments")
}

enum FinInstallmentStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE

  @@map("fin_installment_status")
}

enum FinRateType {
  FIXED
  VARIABLE

  @@map("fin_rate_type")
}

model FinLoanPrepayment {
  id            String          @id @default(dbgenerated("(uuid_generate_v4())::text"))
  loanId        String          @map("loan_id")
  amount        Decimal         @db.Decimal(15, 2)
