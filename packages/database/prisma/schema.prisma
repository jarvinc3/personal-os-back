/// Why a bank charge was recorded. Each kind maps to one system category so
/// the "Cargos bancarios" analytics can group them.
enum FinReconciliationAdjustmentKind {
  IMPUESTO_DGII
  COMISION
  CARGO_PLASTICO
  INTERES
  OTRO

  @@map("fin_reconciliation_adjustment_kind")
}

/// One close of an account or card against the balance the bank shows.
/// Exactly one of `accountId`/`cardId` (DB check), and `currency` is the
/// product currency so a two-currency card reconciles once per currency.
model FinReconciliation {
  id          String                        @id @default(dbgenerated("(uuid_generate_v4())::text"))
  userId      String                        @map("user_id")
  accountId   String?                       @map("account_id")
  cardId      String?                       @map("card_id")
  currency    String
  asOfDate    DateTime                      @map("as_of_date") @db.Date
  appBalance  Decimal                       @map("app_balance") @db.Decimal(15, 2)
  realBalance Decimal                       @map("real_balance") @db.Decimal(15, 2)
  difference  Decimal                       @db.Decimal(15, 2)
  note        String?
  createdAt   DateTime                      @default(now()) @map("created_at") @db.Timestamptz(6)
  account     FinAccount?                   @relation(fields: [accountId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  card        FinCard?                      @relation(fields: [cardId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user        User                          @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  adjustments FinReconciliationAdjustment[]

  @@index([userId, accountId, asOfDate(sort: Desc)], map: "fin_reconciliations_user_account_date_idx")
  @@index([userId, cardId, asOfDate(sort: Desc)], map: "fin_reconciliations_user_card_date_idx")
  @@index([accountId], map: "fin_reconciliations_account_id_idx")
  @@index([cardId], map: "fin_reconciliations_card_id_idx")
  @@map("fin_reconciliations")
}

/// One categorized line of a reconciliation. Each line owns the adjustment
/// movement that moves the product balance.
model FinReconciliationAdjustment {
  id               String                          @id @default(dbgenerated("(uuid_generate_v4())::text"))
  reconciliationId String                          @map("reconciliation_id")
  transactionId    String                          @unique @map("transaction_id")
  kind             FinReconciliationAdjustmentKind
  amount           Decimal                         @db.Decimal(15, 2)
  reconciliation   FinReconciliation               @relation(fields: [reconciliationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  transaction      FinTransaction                  @relation(fields: [transactionId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([reconciliationId], map: "fin_reconciliation_adjustments_reconciliation_idx")
  @@index([transactionId], map: "fin_reconciliation_adjustments_transaction_idx")
  @@map("fin_reconciliation_adjustments")
}

/// Open or closed deviation between a product's stored balance and the sum of
/// its confirmed movements (invariant I1). Recalculating corrects the stored
/// balance and closes the open row; no movement is created.
model FinBalanceDrift {
  id              String      @id @default(dbgenerated("(uuid_generate_v4())::text"))
  userId          String      @map("user_id")
  accountId       String?     @map("account_id")
  cardId          String?     @map("card_id")
  currency        String
  storedBalance   Decimal     @map("stored_balance") @db.Decimal(15, 2)
  expectedBalance Decimal     @map("expected_balance") @db.Decimal(15, 2)
  difference      Decimal     @db.Decimal(15, 2)
  detectedAt      DateTime    @default(now()) @map("detected_at") @db.Timestamptz(6)
  resolvedAt      DateTime?   @map("resolved_at") @db.Timestamptz(6)
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  account         FinAccount? @relation(fields: [accountId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  card            FinCard?    @relation(fields: [cardId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId, resolvedAt], map: "fin_balance_drifts_user_resolved_idx")
  @@index([accountId, resolvedAt], map: "fin_balance_drifts_account_resolved_idx")
  @@index([cardId, resolvedAt], map: "fin_balance_drifts_card_resolved_idx")
  @@map("fin_balance_drifts")
}

/// Server-side idempotency for mutating requests. One row per user and key;
/// it stores the response of the first execution so retries replay it. Rows
/// expire 24 h after creation and are removed lazily when a lookup finds them
/// expired.
model IdempotencyKey {
  id             String            @id @default(dbgenerated("(uuid_generate_v4())::text"))
  userId         String            @map("user_id")
  key            String
  method         String
  path           String
  requestHash    String            @map("request_hash")
  status         IdempotencyStatus @default(IN_PROGRESS)
  responseStatus Int?              @map("response_status")
  responseBody   String?           @map("response_body")
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt      DateTime          @map("expires_at") @db.Timestamptz(6)
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, key], map: "idempotency_keys_user_key_key")
  @@index([expiresAt], map: "idempotency_keys_expires_at_idx")
  @@map("idempotency_keys")
}

enum IdempotencyStatus {
  IN_PROGRESS
  COMPLETED

  @@map("idempotency_status")
}
