/// Read-only public link for a fixed set of receivables. The token is the only
/// way in; revoking flips is_active and regenerating swaps the token.
model FinReceivableShare {
  id         String                   @id @default(dbgenerated("(uuid_generate_v4())::text"))
  userId     String                   @map("user_id")
  token      String                   @unique
  debtorName String                   @map("debtor_name")
  isActive   Boolean                  @default(true) @map("is_active")
  expiresAt  DateTime?                @map("expires_at") @db.Timestamptz(6)
  revokedAt  DateTime?                @map("revoked_at") @db.Timestamptz(6)
  createdAt  DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  user       User                     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  items      FinReceivableShareItem[]

  @@index([userId], map: "fin_receivable_shares_user_id_idx")
  @@map("fin_receivable_shares")
}

/// Frozen set of receivables chosen when the share was created.
model FinReceivableShareItem {
  shareId      String             @map("share_id")
  receivableId String             @map("receivable_id")
  share        FinReceivableShare @relation(fields: [shareId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  receivable   FinReceivable      @relation(fields: [receivableId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([shareId, receivableId])
  @@index([receivableId], map: "fin_receivable_share_items_receivable_id_idx")
  @@map("fin_receivable_share_items")
}

/// One amount collected for a receivable. It carries the movement that put the
/// money in the account, so both sides can be undone together.
model FinReceivablePayment {
  id             String          @id @default(dbgenerated("(uuid_generate_v4())::text"))
  receivableId   String          @map("receivable_id")
  amount         Decimal         @db.Decimal(15, 2)
  appliedAmount  Decimal         @map("applied_amount") @db.Decimal(15, 2)
  excessAmount   Decimal         @default(0) @map("excess_amount") @db.Decimal(15, 2)
  excessHandling String?         @map("excess_handling")
  paidAt         DateTime        @map("paid_at") @db.Date
  /// Account the money entered. Null only after that account is deleted.
  accountId      String?         @map("account_id")
  transactionId  String?         @unique @map("transaction_id")
  notes          String?
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  account        FinAccount?     @relation(fields: [accountId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  receivable     FinReceivable   @relation(fields: [receivableId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  transaction    FinTransaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([receivableId, paidAt], map: "fin_receivable_payments_receivable_id_paid_at_idx")
  @@index([accountId], map: "fin_receivable_payments_account_id_idx")
  @@map("fin_receivable_payments")
}

/// One sync run against a source (scanned / imported / error). Operational history.
model FinEmailSyncLog {
  id              String             @id @default(dbgenerated("(uuid_generate_v4())::text"))
  sourceId        String             @map("source_id")
  startedAt       DateTime           @map("started_at") @db.Timestamptz(6)
  completedAt     DateTime?          @map("completed_at") @db.Timestamptz(6)
  emailsScanned   Int                @default(0) @map("emails_scanned")
  transactionsNew Int                @default(0) @map("transactions_new")
  status          FinEmailSyncStatus @default(RUNNING)
  error           String?
  source          FinEmailSource     @relation(fields: [sourceId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([sourceId, startedAt], map: "fin_email_sync_logs_source_started_idx")
  @@map("fin_email_sync_logs")
}

/// Per-Gmail-message extract outcome (idempotency + review queue). Provider id is gmailMessageId.
model FinEmailMessage {
  id                       String                 @id @default(dbgenerated("(uuid_generate_v4())::text"))
  sourceId                 String                 @map("source_id")
  gmailMessageId           String                 @map("gmail_message_id")
  outcome                  FinEmailMessageOutcome
  reason                   String?
  provider                 String?
  model                    String?
  instrumentHint           String?                @map("instrument_hint")
  lastFourHint             String?                @map("last_four_hint")
  accountNumberHint        String?                @map("account_number_hint")
  extractedPayload         Json?                  @map("extracted_payload")
  fingerprint              String?
  duplicateOfTransactionId String?                @map("duplicate_of_transaction_id")
  createdAt                DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  source                   FinEmailSource         @relation(fields: [sourceId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  transaction              FinTransaction?

  @@unique([sourceId, gmailMessageId], map: "fin_email_messages_source_gmail_key")
  @@unique([sourceId, fingerprint], map: "fin_email_messages_source_fingerprint_key")
  @@index([sourceId], map: "fin_email_messages_source_id_idx")
  @@index([outcome], map: "fin_email_messages_outcome_idx")
  @@map("fin_email_messages")
}

