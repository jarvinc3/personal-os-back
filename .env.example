# ── Base de datos ────────────────────────────────────────────
DATABASE_URL="postgresql://postgres.[project_id]:[password]@aws-1-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require"
# TLS (runtime Nest/pg pool only — Prisma CLI uses DATABASE_URL sslmode as-is)
# Production defaults to rejectUnauthorized=true. Only true|false|1|0 accepted.
# OBLIGATORIO en prod con el pooler de Supabase: su cadena de certificados no pasa
# la verificación estricta (quitarla tumbó prod el 2026-10-22).
DATABASE_SSL_REJECT_UNAUTHORIZED=false
# Arreglo correcto a futuro: cargar el CA de Supabase aquí y volver a true.
# Optional PEM CA (or concatenated bundle) when the host uses a private CA:
# DATABASE_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# ── Supabase ──────────────────────────────────────────────
SUPABASE_URL="YOUR_SUPABASE_URL"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"

# ── Logo.dev (instituciones y redes de tarjeta) ─────────────
# Secret key stays on the backend. Publishable key is also exposed to the web
# preview search only (NEXT_PUBLIC_LOGO_DEV_PUBLISHABLE_KEY).
LOGO_DEV_SECRET_KEY="YOUR_LOGO_DEV_SECRET_KEY"
LOGO_DEV_PUBLISHABLE_KEY="YOUR_LOGO_DEV_PUBLISHABLE_KEY"

# ── IA ───────────────────────────────────
GROQ_API_KEY="YOUR_GROQ_API_KEY"
OPENROUTER_API_KEY="YOUR_OPENROUTER_API_KEY"
# Optional limits (defaults: 25 extracts, 20 insights/day).
# MAX_EMAIL_LLM_EXTRACTS=25
# AI_DAILY_INSIGHT_QUOTA=20

# ── Gmail OAuth (fuente de Inteligencia) ─────────────────────
AI_GMAIL_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID"
AI_GMAIL_CLIENT_SECRET="YOUR_GOOGLE_CLIENT_SECRET"
AI_GMAIL_REDIRECT_URI=http://localhost:3100/api/intelligence/email/oauth/callback
AI_GMAIL_TOKEN_ENCRYPTION_KEY="your-32-char-minimum-key-for-gmail-tokens"
# Optional: promote this account to ADMIN only when NODE_ENV=development.
AI_DEV_ADMIN_EMAIL=
# AI_GLOBAL_MIN_CONTRIBUTORS=1 # default development=1; test/production=3
ENCRYPTION_KEY="your-32-char-minimum-encryption-key-here"

# Encrypts bank account numbers at rest; keep it separate from Gmail token key.
DATA_ENCRYPTION_KEY="your-32-char-minimum-encryption-key-here"

# Raw Gmail body retention: 30 days in DEV and 7 days in PROD; canonical content is durable.

# Required in production (≥32 chars). In non-prod, falls back to ENCRYPTION_KEY with a warning.
OAUTH_STATE_SECRET="your-32-char-minimum-oauth-state-secret-here"

# ── Redis / BullMQ ───────────────────────────────────────────
# Development: local Redis (docker compose up -d redis).
# Production: internal Railway URL, never the public TCP proxy.
REDIS_ENABLED=true
REDIS_URL="redis://localhost:6379"

# ── Bull Board (dashboard de BullMQ credentials) ─────────────────────────────
BULL_BOARD_USER=admin
BULL_BOARD_PASSWORD=admin1234

# ── App ──────────────────────────────────────────────────────
PORT=3100
NODE_ENV="development"
CORS_ORIGIN=http://localhost:3000
# Previews de rama de Vercel en dev: patrones anclados separados por comas.
# En production la variable no se acepta y se usa solo CORS_ORIGIN.
# CORS_ORIGIN_PATTERNS="^https://personal-os-web-git-[a-z0-9-]+-collado-studios\.vercel\.app$"
# Base de la web pública para los links de cobros (`<PUBLIC_WEB_URL>/c/<token>`).
# Sin valor se usa el primer origin de CORS_ORIGIN.
PUBLIC_WEB_URL=http://localhost:3000
API_PREFIX="api"
SWAGGER_PATH="docs"

# ── Sentry (opcional; sin DSN no se inicializa) ──────────────
# SENTRY_DSN="https://your-key@o0.ingest.sentry.io/0"
# SENTRY_TRACES_SAMPLE_RATE=0.1
# Solo para subir source maps en el build; sin token el build no falla.
# SENTRY_AUTH_TOKEN="YOUR_SENTRY_AUTH_TOKEN"
# SENTRY_ORG="collado-studios"
# SENTRY_PROJECT="personal-os-back"

# ── Push nativo Android (FCM) ───────────────────
# Las tres variables juntas habilitan el canal; si falta alguna, queda apagado
# sin romper el arranque. La clave acepta saltos de línea reales o "\n" literales.
FIREBASE_PROJECT_ID="personal-os-xxxxxx"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@personal-os-xxxxxx.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ── Expo Push ───────────────────────────────────
EXPO_ACCESS_TOKEN="YOUR_EXPO_ACCESS_TOKEN"

# ── Web Push (Vapid keys) ────────────────────────────────────
VAPID_PUBLIC_KEY="YOUR_VAPID_PUBLIC_KEY"
VAPID_PRIVATE_KEY="YOUR_VAPID_PRIVATE_KEY"
VAPID_SUBJECT="mailto:support@personal-os.local"

# ── Exchange Rate (exchangerate.host histórico; exact date o falla) ──
EXCHANGE_RATE_HOST_API_KEY="YOUR_EXCHANGE_RATE_HOST_API_KEY"
BASE_CURRENCY="DOP"

# ── Mail delivery (Resend; EMAIL channel A2) ───────────────────
# Keep false until RESEND_API_KEY + MAIL_FROM are set (domain verified in Resend).
EMAIL_DELIVERY_ENABLED=false
RESEND_API_KEY="YOUR_RESEND_API_KEY"
MAIL_FROM="Personal OS <notify@your-domain.com>"
