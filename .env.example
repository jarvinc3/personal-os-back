# ── Base de datos ────────────────────────────────────────────
DATABASE_URL="postgresql://postgres.[project_id]:[password]@aws-1-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require"

# ── Supabase ──────────────────────────────────────────────
SUPABASE_URL="YOUR_SUPABASE_URL"
SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"

# ── IA (free tier) ────────────────────────
CEREBRAS_API_KEY="YOUR_CEREBRAS_API_KEY"
GROQ_API_KEY="YOUR_GROQ_API_KEY"
OPENROUTER_API_KEY="YOUR_OPENROUTER_API_KEY"

# ── Google OAuth (para Gmail API) ────────────────────────────
GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID"
GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_CLIENT_SECRET"
GOOGLE_REDIRECT_URI=http://localhost:3100/api/finance/email-sync/oauth/google/callback
ENCRYPTION_KEY="your-32-char-minimum-encryption-key-here"
# Required in production (≥32 chars). In non-prod, falls back to ENCRYPTION_KEY with a warning.
OAUTH_STATE_SECRET="your-32-char-minimum-oauth-state-secret-here"

# ── Redis / BullMQ ───────────────────────────────────────────
REDIS_ENABLED=true
REDIS_URL="railway_public_redis_url"

# ── App ──────────────────────────────────────────────────────
PORT=3100
NODE_ENV="development"
CORS_ORIGIN=http://localhost:3000
API_URL=http://localhost:3100
API_PREFIX="api"
SWAGGER_PATH="docs"

# ── Push (Expo + Web Push) ───────────────────────────────────
EXPO_ACCESS_TOKEN="YOUR_EXPO_ACCESS_TOKEN"

# ── Web Push (Vapid keys) ────────────────────────────────────
VAPID_PUBLIC_KEY="YOUR_VAPID_PUBLIC_KEY"
VAPID_PRIVATE_KEY="YOUR_VAPID_PRIVATE_KEY"
VAPID_SUBJECT="mailto:support@personal-os.local"

# ── Moneda base (para conversiones) ──────────────────────────
BASE_CURRENCY="DOP"
# Reserved / unused in app code today — do not rely on FX conversion yet.
# EXCHANGE_RATE_HOST_API_KEY="YOUR_EXCHANGE_RATE_HOST_API_KEY"
