# ── Base de datos ────────────────────────────────────────────
DATABASE_URL="postgresql://postgres.[project_id]:[password]@aws-1-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require"
# TLS (runtime Nest/pg pool only — Prisma CLI uses DATABASE_URL sslmode as-is)
# Production defaults to rejectUnauthorized=true. Only true|false|1|0 accepted.
# DATABASE_SSL_REJECT_UNAUTHORIZED=true
# Optional PEM CA (or concatenated bundle) when the host uses a private CA:
# DATABASE_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# ── Supabase ──────────────────────────────────────────────
SUPABASE_URL="YOUR_SUPABASE_URL"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"

# ── Logo.dev (instituciones y redes de tarjeta) ─────────────
# Secret key stays on the backend. Publishable key is also exposed to the web
# preview search only (NEXT_PUBLIC_LOGO_DEV_PUBLISHABLE_KEY).
LOGO_DEV_SECRET_KEY="YOUR_LOGO_DEV_SECRET_KEY"
LOGO_DEV_PUBLISHABLE_KEY="YOUR_LOGO_DEV_PUBLISHABLE_KEY"

# ── IA (free tier) ────────────────────────
CEREBRAS_API_KEY="YOUR_CEREBRAS_API_KEY"
GROQ_API_KEY="YOUR_GROQ_API_KEY"
OPENROUTER_API_KEY="YOUR_OPENROUTER_API_KEY"
# Optional limits (defaults: 25 extracts, 20 insights/day).
# MAX_EMAIL_LLM_EXTRACTS=25
# AI_DAILY_INSIGHT_QUOTA=20

# ── Google OAuth (para Gmail API) ────────────────────────────
GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID"
GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_CLIENT_SECRET"
GOOGLE_REDIRECT_URI=http://localhost:3100/api/finance/email-sync/oauth/google/callback
ENCRYPTION_KEY="your-32-char-minimum-encryption-key-here"

# Required in production (≥32 chars). In non-prod, falls back to ENCRYPTION_KEY with a warning.
OAUTH_STATE_SECRET="your-32-char-minimum-oauth-state-secret-here"

# ── Redis / BullMQ ───────────────────────────────────────────
# Development: local Redis (docker compose up -d redis).
# Production: internal Railway URL, never the public TCP proxy.
REDIS_ENABLED=true
REDIS_URL="redis://localhost:6379"

# ── Bull Board (dashboard de BullMQ credentials) ─────────────────────────────
BULL_BOARD_USER=admin
BULL_BOARD_PASSWORD=admin1234

# ── App ──────────────────────────────────────────────────────
PORT=3100
NODE_ENV="development"
CORS_ORIGIN=http://localhost:3000
API_PREFIX="api"
SWAGGER_PATH="docs"

# ── Expo Push ───────────────────────────────────
EXPO_ACCESS_TOKEN="YOUR_EXPO_ACCESS_TOKEN"

# ── Web Push (Vapid keys) ────────────────────────────────────
VAPID_PUBLIC_KEY="YOUR_VAPID_PUBLIC_KEY"
VAPID_PRIVATE_KEY="YOUR_VAPID_PRIVATE_KEY"
VAPID_SUBJECT="mailto:support@personal-os.local"

# ── Exchange Rate (exchangerate.host histórico; exact date o falla) ──
EXCHANGE_RATE_HOST_API_KEY="YOUR_EXCHANGE_RATE_HOST_API_KEY"
BASE_CURRENCY="DOP"

# ── Mail delivery (Resend; EMAIL channel A2) ───────────────────
# Keep false until RESEND_API_KEY + MAIL_FROM are set (domain verified in Resend).
EMAIL_DELIVERY_ENABLED=false
RESEND_API_KEY="YOUR_RESEND_API_KEY"
MAIL_FROM="Personal OS <notify@your-domain.com>"
