{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "moduleNameMapper": {
    "^(\\.{1,2}/.*)\\.js$": "$1",
    "^@personal-os/([^/]+)$": "<rootDir>/../packages/$1/src",
    "^@openrouter/sdk$": "<rootDir>/stubs/openrouter-sdk.ts"
  },
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  }
}
